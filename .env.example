# Copy this file to .env and fill in your real values.
# Do NOT commit the .env file anywhere or share it — PLEX_TOKEN grants full
# admin access to your server.

# Your Plex server's local address and port (default port is 32400).
PLEX_URL=http://192.168.1.50:32400

# The SERVER ADMIN/OWNER's X-Plex-Token (see README.md for how to find it).
PLEX_TOKEN=

# Exact, case-sensitive title of the playlist to sync.
PLAYLIST_NAME=Kate's favourites

# Comma-separated Plex Home usernames to sync the playlist to.
TARGET_USERS=Kate

# How often to re-sync, in hours.
SYNC_INTERVAL_HOURS=24
